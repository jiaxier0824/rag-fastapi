DASHSCOPE_API_KEY=your_dashscope_api_key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=rag_project
# 仅 Docker Compose 使用；生产部署时务必改掉默认密码。
MYSQL_ROOT_PASSWORD=change_me_before_deploy
MYSQL_APP_USER=rag_user
MYSQL_APP_PASSWORD=change_me_before_deploy
# 宿主机 3306 常被本机 MySQL 占用；Docker 示例默认使用 3307。
MYSQL_PORT=3307
APP_PORT=8000

UPLOAD_DIR=./uploads
CHROMA_COLLECTION_NAME=rag
CHROMA_PERSIST_DIR=./chroma_db
CHAT_HISTORY_DIR=./chat_history

CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3
RETRIEVAL_VECTOR_TOP_K=5
RETRIEVAL_KEYWORD_TOP_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_TOP_K=6
RERANK_ENABLED=false
RERANK_MODEL_NAME=qwen3-rerank
RERANK_TOP_N=3
RERANK_TIMEOUT_SECONDS=10
# 启用重排时填写百炼业务空间 ID；不要填写 API Key。
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
OBSERVABILITY_LOG_PATH=./logs/rag_requests.jsonl
EMBEDDING_MODEL_NAME=text-embedding-v4
# 日常 RAG 问答优先低延迟；如需更强推理能力，可在部署环境单独覆盖。
CHAT_MODEL_NAME=qwen-turbo
